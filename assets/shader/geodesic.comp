#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
};

layout(std140, binding = 3) uniform LensObjects {
    int numObjects;
    vec4 objPosRadius[2];
    vec4 objColor[2];
};

layout(std140, binding = 4) uniform BlackHole {
    vec3 worldPos;
    float _padBH0;
};

uniform ivec2 uResolution;

const float SagA_rs = 1.269e10;
const float D_LAMBDA = 1e7;
const float ESCAPE_R = 1e30;

struct Ray {
    float x, y, z, r, theta, phi;
    float dr, dtheta, dphi;
    float E, L;
};

vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);
float hitRadius = 0.0;

Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r = max(length(pos), 1.0);
    ray.theta = acos(clamp(pos.y / ray.r, -0.999999, 0.999999));
    ray.phi = atan(pos.z, pos.x);

    float dx = dir.x, dy = dir.y, dz = dir.z;
    float sinTheta = max(abs(sin(ray.theta)), 1e-4);
    ray.dr     = sin(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*dy + sin(ray.theta)*sin(ray.phi)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx - sin(ray.theta)*dy + cos(ray.theta)*sin(ray.phi)*dz) / ray.r;
    ray.dphi   = (-sin(ray.phi)*dx + cos(ray.phi)*dz) / (ray.r * sinTheta);

    ray.L = ray.r * ray.r * sinTheta * ray.dphi;
    float f = 1.0 - SagA_rs / ray.r;
    float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + sinTheta*sinTheta*ray.dphi*ray.dphi));
    ray.E = f * dt_dL;

    return ray;
}

vec3 backgroundColor(vec3 dir) {
    vec3 cell = floor(dir * 120.0);
    float n = fract(sin(dot(cell, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
    float star = step(0.9965, n);
    return vec3(star);
}

bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}

bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);

    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;

        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            hitRadius = radius;
            return true;
        }
    }

    return false;
}

vec3 shadeObject(vec3 P) {
    vec3 N = normalize(P - hitCenter);
    vec3 lightDir = normalize(vec3(-0.35, 0.65, 0.45));
    float diffuse = max(dot(N, lightDir), 0.0);

    float longitude = atan(N.z, N.x) / 6.2831853 + 0.5;
    float latitude = asin(clamp(N.y, -1.0, 1.0)) / 3.1415926 + 0.5;
    float verticalStripe = step(0.5, fract(longitude * 12.0));
    float horizontalStripe = smoothstep(0.47, 0.5, abs(fract(latitude * 8.0) - 0.5));
    float stripe = max(verticalStripe * 0.35, horizontalStripe * 0.25);

    vec3 base = objectColor.rgb;
    vec3 striped = mix(base, vec3(1.0), stripe);
    return striped * (0.22 + 0.78 * diffuse);
}

void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;
    float f = 1.0 - SagA_rs / r;
    float dt_dL = ray.E / f;
    float sinTheta = max(sin(theta), 1e-4);

    d1 = vec3(dr, dtheta, dphi);
    d2.x = - (SagA_rs / (2.0 * r*r)) * f * dt_dL * dt_dL
         + (SagA_rs / (2.0 * r*r * f)) * dr * dr
         + r * (dtheta*dtheta + sinTheta*sinTheta*dphi*dphi);
    d2.y = -2.0*dr*dtheta/r + sin(theta)*cos(theta)*dphi*dphi;
    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/sinTheta * dtheta * dphi;
}
void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b;
    geodesicRHS(ray, k1a, k1b);

    ray.r      += dL * k1a.x;
    ray.theta  += dL * k1a.y;
    ray.phi    += dL * k1a.z;
    ray.dr     += dL * k1b.x;
    ray.dtheta += dL * k1b.y;
    ray.dphi   += dL * k1b.z;

    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * cos(ray.theta);
    ray.z = ray.r * sin(ray.theta) * sin(ray.phi);
}
bool crossesEquatorialPlane(vec3 oldPos, vec3 newPos) {
    bool crossed = (oldPos.y * newPos.y < 0.0);
    float r = length(vec2(newPos.x, newPos.z));
    return crossed && (r >= disk_r1 && r <= disk_r2);
}

void main() {
    int WIDTH = uResolution.x;
    int HEIGHT = uResolution.y;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    // Init Ray
    // If the screen is positioned at a distance of 1 in front of the camera,
    // tanHalfFov(tan(fov / 2)) equals the position or distance of the pixel in the screen
    // Moreover, the width needs to be scaled according to the aspect ratio

    float u = (2.0 * (pix.x + 0.5) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);

    // Integrate in black-hole local space. cam.camPos is world-space, while
    // the Schwarzschild equations assume the black hole is at the origin.
    Ray ray = initRay(cam.camPos - worldPos, dir);
    vec3 initialDir = dir;

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    float lambda = 0.0;

    bool hitBlackHole = false;
    bool hitDisk      = false;
    bool hitObject    = false;
    int steps = cam.moving != 0 ? 60000 : 60000;

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray, SagA_rs)) { hitBlackHole = true; break; }
        rk4Step(ray, D_LAMBDA);
        lambda += D_LAMBDA;

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        if (crossesEquatorialPlane(prevPos, newPos)) { hitDisk = true; break; }
        if (interceptObject(ray)) { hitObject = true; break; }
        prevPos = newPos;
        if (ray.r > ESCAPE_R) break;
    }

    if (hitDisk) {
        float r = length(vec3(ray.x, ray.y, ray.z)) / disk_r2;
        vec3 diskColor = vec3(1.0, r, 0.2);
        //r = 1.0 - abs(r - 0.5) * 2.0;
        color = vec4(diskColor, r);

    } else if (hitBlackHole) {
        color = vec4(0.0, 0.0, 0.0, 1.0);

    } else if (hitObject) {
        vec3 P = vec3(ray.x, ray.y, ray.z);
        color = vec4(shadeObject(P), objectColor.a);

    } else {
        color = vec4(backgroundColor(initialDir), 1.0);
    }

    imageStore(outImage, pix, color);
}
